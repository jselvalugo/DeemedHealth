{
  "name": "@deemed/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Deemed Health design system: tokens, app shell, launcher, module registry, shared components.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module-registry": {
      "types": "./dist/module-registry.d.ts",
      "default": "./dist/module-registry.js"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@deemed/dates": "workspace:*",
    "@deemed/domain": "workspace:*",
    "@deemed/i18n": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "lucide-react": "^1.48.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
