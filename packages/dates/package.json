{
  "name": "@deemed/dates",
  "version": "0.0.0",
  "private": true,
  "description": "The one due-date, cadence, and time-zone package (ADR-0001). No runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
