    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
