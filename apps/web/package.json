{
  "name": "@deemed/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -b ../../packages/domain ../../packages/i18n ../../packages/ui && next dev",
    "build": "tsc -b ../../packages/domain ../../packages/i18n ../../packages/ui && next build",
    "start": "next start",
    "typecheck": "tsc -b ../../packages/domain ../../packages/i18n ../../packages/ui && next typegen && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deemed/domain": "workspace:*",
    "@deemed/i18n": "workspace:*",
    "@deemed/ui": "workspace:*",
