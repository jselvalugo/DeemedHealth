{
  "name": "@deemed/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -b ../../packages/domain ../../packages/i18n && next dev",
    "build": "tsc -b ../../packages/domain ../../packages/i18n && next build",
    "start": "next start",
    "typecheck": "tsc -b ../../packages/domain ../../packages/i18n && next typegen && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deemed/domain": "workspace:*",
    "@deemed/i18n": "workspace:*",
    "next": "^16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
